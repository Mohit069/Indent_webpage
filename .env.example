# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres. Works with any Postgres 14+ - a local install on your server,
# Supabase, Neon, or a Docker container.
#   local:    postgresql://postgres:yourpassword@localhost:5432/indent
#   Supabase: take the "Connection string / URI" from Project Settings > Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/indent

# The prefix on every issued indent number, e.g. MQ/IND/26-27/0001
INDENT_PREFIX=MQ/IND


# Optional - connection pool size. Raise it only if you see connections queueing.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# There is no SESSION_SECRET, and no accounts.
#
# This app has no sign-in: anyone who can reach the page can raise, approve and
# edit anything. The network is the access control - keep it on the office LAN
# or behind a VPN, and do not give it a public hostname.
# ---------------------------------------------------------------------------