# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres. Works with any Postgres 14+ - a local install on your server,
# Supabase, Neon, or a Docker container.
#   local:    postgresql://postgres:yourpassword@localhost:5432/indent
#   Supabase: take the "Connection string / URI" from Project Settings > Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/indent

# The prefix on every issued indent number, e.g. MQ/IND/26-27/0001
INDENT_PREFIX=MQ/IND


# Optional - connection pool size. Raise it only if you see connections queueing.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# There is no SESSION_SECRET, and nothing here is a password.
#
# Everyone signs in with an email address and their own password. Sessions are
# rows in the database and the cookie holds a random secret, so there is nothing
# to sign - and nothing to rotate or lose.
#
# Create the first account after migrating:
#     npm run db:migrate
#     npm run db:seed          # units, departments, starter items
#     npm run db:seed-admin    # the first Super Admin - prints a password once
#
# Pass ADMIN_PASSWORD=... to db:seed-admin to choose that password yourself.
# Either way the account is forced to change it at first sign-in.
# ---------------------------------------------------------------------------
